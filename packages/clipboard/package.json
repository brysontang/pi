{
	"name": "@earendil-works/clipboard",
	"version": "0.85.0",
	"description": "Native clipboard access for Node.js and Bun",
	"type": "commonjs",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.cjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"native/**/*.md",
		"native/**/*.node",
		"scripts/build.mjs",
		"scripts/build-native.mjs",
		"src/**/*.rs",
		".cargo/config.toml",
		"build.rs",
		"Cargo.lock",
		"Cargo.toml",
		"index.cjs",
		"index.d.ts",
		"rustfmt.toml",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "node scripts/build.mjs",
		"build:native": "node scripts/build-native.mjs",
		"build:native:darwin": "node scripts/build-native.mjs --target aarch64-apple-darwin --target x86_64-apple-darwin",
		"build:native:win32": "node scripts/build-native.mjs --target aarch64-pc-windows-msvc --target x86_64-pc-windows-msvc",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"clipboard",
		"native",
		"napi",
		"image"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/clipboard"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
